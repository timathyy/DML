<UserControl x:Class="Dml.Launcher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:Dml.Launcher.Domain.Settings;assembly=Dml.Launcher.Domain"
             Background="{DynamicResource AppBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="52,46,52,52" MaxWidth="760">
      <TextBlock Text="DML PREFERENCES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock Text="启动器设置" Margin="0,10,0,0" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="管理 DML 的本地数据、下载连接和界面偏好。更改会保存在当前设备。" Margin="0,8,0,30" FontSize="14" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />

      <Border Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="存储与下载" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="设置游戏文件位置和网络任务的处理方式。" Margin="0,5,0,24" FontSize="13" Foreground="{DynamicResource MutedForeground}" />
          <TextBlock Text="{DynamicResource GameRootDirectory}" FontSize="13" FontWeight="SemiBold" />
          <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding GameRootDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,6" />
          <TextBlock Text="DML 会在此位置创建独立的游戏数据目录。" FontSize="12" Foreground="{DynamicResource SubtleForegroundBrush}" />
          <StackPanel Margin="0,26,0,0">
            <TextBlock Text="{DynamicResource DownloadConcurrency}" FontSize="13" FontWeight="SemiBold" />
            <ComboBox Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding DownloadConcurrency}" SelectedValuePath="Tag" Margin="0,8,0,0">
              <ComboBoxItem Content="1 个任务" Tag="1" />
              <ComboBoxItem Content="2 个任务" Tag="2" />
              <ComboBoxItem Content="3 个任务" Tag="3" />
              <ComboBoxItem Content="4 个任务（推荐）" Tag="4" />
              <ComboBoxItem Content="6 个任务" Tag="6" />
              <ComboBoxItem Content="8 个任务" Tag="8" />
              <ComboBoxItem Content="12 个任务" Tag="12" />
              <ComboBoxItem Content="16 个任务" Tag="16" />
            </ComboBox>
            <TextBlock Text="{DynamicResource ProxyAddress}" Margin="0,22,0,0" FontSize="13" FontWeight="SemiBold" />
            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="例如：http://127.0.0.1:7890" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="选择适合当前环境的显示主题。" Margin="0,5,0,20" FontSize="13" Foreground="{DynamicResource MutedForeground}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource Theme}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="深色主题采用更柔和的对比度，适合夜间使用。" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SubtleForegroundBrush}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Tag">
              <ComboBoxItem Content="跟随系统" Tag="{x:Static domain:LauncherTheme.System}" />
              <ComboBoxItem Content="浅色" Tag="{x:Static domain:LauncherTheme.Light}" />
              <ComboBoxItem Content="深色" Tag="{x:Static domain:LauncherTheme.Dark}" />
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Save}" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
