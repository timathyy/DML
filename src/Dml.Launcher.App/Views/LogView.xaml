<UserControl x:Class="Dml.Launcher.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource Logs}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource LogsHint}" Foreground="{DynamicResource MutedForeground}" Margin="0,6,0,20" />
    </StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" FontFamily="Consolas" FontSize="12" />
  </Grid>
</UserControl>
