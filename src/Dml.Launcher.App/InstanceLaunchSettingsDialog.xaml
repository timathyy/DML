<Window x:Class="Dml.Launcher.App.InstanceLaunchSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DML"
        Width="590"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{DynamicResource PageForeground}"
        Loaded="Window_Loaded">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="28">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
        <TextBlock Text="原版启动设置" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="选择 Java 并配置此实例的内存、窗口和 JVM 参数。" Margin="0,6,0,0" Foreground="{DynamicResource MutedForeground}" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" MaxHeight="570" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Java 可执行文件" FontWeight="SemiBold" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="JavaPathBox" Style="{StaticResource ModernTextBoxStyle}" />
            <Button Grid.Column="1" Style="{StaticResource NeutralButtonStyle}" Content="浏览" Margin="8,0,0,0" Click="BrowseJava_Click" />
          </Grid>
          <ComboBox x:Name="DetectedJavaBox"
                    Style="{StaticResource ModernComboBoxStyle}"
                    DisplayMemberPath="DisplayName"
                    Margin="0,8,0,0"
                    SelectionChanged="DetectedJavaBox_SelectionChanged" />
          <TextBlock x:Name="JavaStatusText" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />

          <TextBlock Text="最大内存（MB）" Margin="0,18,0,0" FontWeight="SemiBold" />
          <TextBox x:Name="MemoryBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,8,0,0" />

          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="窗口宽度" FontWeight="SemiBold" />
              <TextBox x:Name="WidthBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="窗口高度" FontWeight="SemiBold" />
              <TextBox x:Name="HeightBox" Style="{StaticResource ModernTextBoxStyle}" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
          <CheckBox x:Name="FullscreenBox" Style="{StaticResource CircularCheckBoxStyle}" Content="全屏启动" Margin="0,15,0,0" />

          <TextBlock Text="额外 JVM 参数" Margin="0,18,0,0" FontWeight="SemiBold" />
          <TextBox x:Name="JvmArgumentsBox"
                   Style="{StaticResource ModernTextBoxStyle}"
                   Margin="0,8,0,0"
                   AcceptsReturn="True"
                   MinHeight="68"
                   TextWrapping="Wrap" />
          <TextBlock Text="例如：-XX:+UseG1GC。内存参数由上方设置生成，无需重复填写。" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedForeground}" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
        <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存" IsDefault="True" Click="Confirm_Click" MinWidth="100" />
        <Button Style="{StaticResource NeutralButtonStyle}" Content="取消" IsCancel="True" MinWidth="92" Margin="12,0,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
