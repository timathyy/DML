<Window x:Class="Dml.Launcher.App.InstanceNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DML" Width="390" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}">
  <StackPanel Margin="24">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
    <TextBlock x:Name="LabelText" Margin="0,20,0,7" />
    <TextBox x:Name="NameBox" MinWidth="300" Padding="9,6" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="取消" IsCancel="True" Padding="15,6" />
      <Button Content="确认" IsDefault="True" Click="Confirm_Click" Padding="15,6" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
