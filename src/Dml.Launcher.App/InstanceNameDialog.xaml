<Window x:Class="Dml.Launcher.App.InstanceNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DML"
        Width="390"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="16"
          Padding="28">
    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontSize="21"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource PageForeground}"
                 MouseLeftButtonDown="TitleText_MouseLeftButtonDown" />
      <TextBox x:Name="NameBox"
               Style="{StaticResource ModernTextBoxStyle}"
               MinWidth="300"
               Margin="0,22,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
        <Button Style="{StaticResource PrimaryButtonStyle}"
                Content="确认"
                IsDefault="True"
                Click="Confirm_Click"
                MinWidth="92" />
        <Button Style="{StaticResource NeutralButtonStyle}"
                Content="取消"
                IsCancel="True"
                MinWidth="92"
                Margin="12,0,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
